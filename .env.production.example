NODE_ENV=production
APP_ENV=production
APP_VERSION=0.1.0
GIT_COMMIT_SHA=replace-at-build
NEXT_PUBLIC_API_URL=https://api.example.edu
API_URL=https://api.example.edu
PORT=4000
API_PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@managed-pooler:6432/campustest_pro?schema=public&pgbouncer=true
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@managed-postgres:5432/campustest_pro?schema=public
REDIS_URL=rediss://redis.example.edu:6379
JWT_ACCESS_SECRET=replace-with-long-random-production-secret
JWT_REFRESH_SECRET=replace-with-different-long-random-production-secret
COOKIE_SECURE=true
COOKIE_DOMAIN=.example.edu
CORS_ORIGINS=https://app.example.edu
FRONTEND_URL=https://app.example.edu
WEB_ORIGIN=https://app.example.edu
SWAGGER_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=CampusTest Pro <no-reply@example.edu>
SMTP_URL=smtps://USER:PASSWORD@smtp.example.edu:465
LOG_LEVEL=info
OTEL_ENABLED=true
OTEL_EXPORTER_ENDPOINT=https://otel.example.edu/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.edu/v1/traces
SENTRY_DSN=
ERROR_TRACKING_DSN=
STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=https://s3-compatible-provider.example
OBJECT_STORAGE_BUCKET=campustest-production-private
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=replace-through-secret-manager
OBJECT_STORAGE_SECRET_KEY=replace-through-secret-manager
STORAGE_BUCKET=campustest-production-private
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-through-secret-manager
S3_SECRET_ACCESS_KEY=replace-through-secret-manager
CODE_RUNNER_MODE=REMOTE_RUNNER
CODE_RUNNER_URL=https://code-runner.internal
CODE_RUNNER_INTERNAL_URL=https://code-runner.internal
CODE_RUNNER_INTERNAL_TOKEN=replace-through-secret-manager
INTERNAL_SERVICE_TOKEN=replace-through-secret-manager
FEATURE_FLAGS={"readReplica":true,"examSafeDeployments":true}
WORKER_REQUIRED=true
WORKER_CONCURRENCY=10
MAINTENANCE_MODE=false
RELEASE_VERSION=0.1.0
COMMIT_SHA=replace-at-build
BUILD_TIMESTAMP=replace-at-build
