FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
RUN npm ci

FROM deps AS build
COPY . .
RUN npm run db:generate && npm run build --workspace apps/worker

FROM node:22-alpine AS runtime
ARG APP_VERSION=0.1.0
ARG GIT_COMMIT_SHA=local
LABEL org.opencontainers.image.title="campustest-worker" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT_SHA}" \
      org.opencontainers.image.source="https://github.com/sdramadhar/campus-test-pro"
ENV NODE_ENV=production
ENV APP_ENV=production
WORKDIR /app
RUN addgroup -S campustest && adduser -S campustest -G campustest && mkdir -p /tmp/campustest && chown -R campustest:campustest /tmp/campustest
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
RUN npm ci --omit=dev --workspace apps/worker --workspace apps/api --include-workspace-root=false
COPY --from=build /app/apps/api/generated apps/api/generated
COPY --from=build /app/apps/worker/dist apps/worker/dist
USER campustest
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "process.exit(0)"
CMD ["npm", "run", "start", "--workspace", "apps/worker"]
