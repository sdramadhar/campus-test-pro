NODE_ENV=staging
APP_ENV=staging
APP_VERSION=0.1.0
GIT_COMMIT_SHA=replace-at-build
NEXT_PUBLIC_API_URL=https://api.staging.example.edu
API_URL=https://api.staging.example.edu
PORT=4000
API_PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@pgbouncer:6432/campustest_pro?schema=public&pgbouncer=true
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/campustest_pro?schema=public
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace-with-staging-secret
JWT_REFRESH_SECRET=replace-with-different-staging-secret
COOKIE_SECURE=true
COOKIE_DOMAIN=.staging.example.edu
CORS_ORIGINS=https://staging.example.edu
FRONTEND_URL=https://staging.example.edu
WEB_ORIGIN=https://staging.example.edu
SWAGGER_ENABLED=true
EMAIL_PROVIDER=console
EMAIL_FROM=CampusTest Pro Staging <no-reply@staging.example.edu>
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
OTEL_EXPORTER_OTLP_ENDPOINT=
STORAGE_PROVIDER=local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=campustest-staging-private
OBJECT_STORAGE_REGION=local
OBJECT_STORAGE_ACCESS_KEY=replace-through-secret-manager
OBJECT_STORAGE_SECRET_KEY=replace-through-secret-manager
STORAGE_BUCKET=campustest-staging
CODE_RUNNER_MODE=DISABLED
CODE_RUNNER_URL=
CODE_RUNNER_INTERNAL_TOKEN=replace-through-secret-manager
INTERNAL_SERVICE_TOKEN=replace-through-secret-manager
ERROR_TRACKING_DSN=
FEATURE_FLAGS={"readReplica":false,"examSafeDeployments":true}
WORKER_REQUIRED=true
WORKER_CONCURRENCY=5
MAINTENANCE_MODE=false
RELEASE_VERSION=0.1.0
COMMIT_SHA=replace-at-build
BUILD_TIMESTAMP=replace-at-build
