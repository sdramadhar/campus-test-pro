}

model AiUsageRecord {
  id             String           @id @default(cuid())
  collegeId      String
  college        College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  userId         String?
  jobId          String?
  job            AiGenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  provider       String
  model          String
  requestType    String
  inputTokens    Int              @default(0)
  outputTokens   Int              @default(0)
  estimatedCost  Float?
  actualCost     Float?
  success        Boolean
  failureSummary String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([collegeId])
  @@index([userId])
  @@index([jobId])
  @@index([createdAt])
}

model AiPromptTemplate {
  id                    String              @id @default(cuid())
  collegeId             String?
  college               College?            @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name                  String
  featureType           AiPromptFeatureType
  systemInstruction     String
  userPromptTemplate    String
  variables             String[]
  version               Int                 @default(1)
  active                Boolean             @default(true)
  providerCompatibility String[]
  temperature           Float               @default(0.2)
  maxTokens             Int                 @default(1200)
  model                 String?
  createdById           String?
  createdBy             User?               @relation("AiPromptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById           String?
  updatedBy             User?               @relation("AiPromptUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  versionHistory        Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([collegeId, name, version])
  @@index([collegeId])
  @@index([featureType])
  @@index([active])
}

model AiProviderFailure {
  id             String    @id @default(cuid())
  collegeId      String?
  college        College?  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  provider       String
  model          String?
  normalizedCode String
  sanitizedError String
  failureCount   Int       @default(1)
  disabledUntil  DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([collegeId])
  @@index([provider])
  @@index([disabledUntil])
}

model DocumentImportJob {
  id               String                       @id @default(cuid())
  collegeId        String
  college          College                      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  requestedById    String
  requestedBy      User                         @relation("DocumentImportRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject?                     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  status           DocumentImportStatus         @default(UPLOADED)
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  sourceKind       String
  parserProvider   String?
  ocrProvider      String?
  ocrAttempted     Boolean                      @default(false)
  ocrConfidence    Float?
  extractedChars   Int                          @default(0)
  candidateCount   Int                          @default(0)
  approvedCount    Int                          @default(0)
  errorSummary     String?
  expiresAt        DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  document         ImportedDocument?
  candidates       ExtractedQuestionCandidate[]
  validationErrors ImportValidationError[]

  @@index([collegeId])
  @@index([requestedById])
  @@index([subjectId])
  @@index([status])
}

model ImportedDocument {
  id             String            @id @default(cuid())
  jobId          String            @unique
  job            DocumentImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  collegeId      String
  college        College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  fileName       String
  storageKey     String
  checksum       String?
  retentionUntil DateTime?
  metadata       Json?
  chunks         DocumentChunk[]
  createdAt      DateTime          @default(now())

  @@index([collegeId])
}

model DocumentChunk {
  id          String           @id @default(cuid())
  documentId  String
  document    ImportedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber  Int?
  sheetName   String?
  rowNumber   Int?
  paragraph   Int?
  chunkIndex  Int
  textPreview String
  textHash    String
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model ExtractedQuestionCandidate {
  id                  String              @id @default(cuid())
  jobId               String
  job                 DocumentImportJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  questionId          String?
  question            Question?           @relation(fields: [questionId], references: [id], onDelete: SetNull)
  reviewStatus        AiReviewStatus      @default(PENDING)
  sourceReference     Json
  questionType        QuestionType
  questionText        String
  options             Json?
  correctAnswer       Json?
  explanation         String?
  suggestedSubjectId  String?
  suggestedTopic      String?
  suggestedDifficulty QuestionDifficulty?
  approvedDifficulty  QuestionDifficulty?
  suggestedBloomLevel BloomLevel?
  approvedBloomLevel  BloomLevel?
  validationIssues    String[]
  warnings            String[]
  confidence          Float?
  duplicateCandidate  Boolean             @default(false)
  duplicateReason     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([jobId])
  @@index([questionId])
  @@index([reviewStatus])
}

model ImportValidationError {
  id        String            @id @default(cuid())
  jobId     String
  job       DocumentImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  location  Json?
  message   String
  rowData   Json?
  createdAt DateTime          @default(now())

  @@index([jobId])
}

model QuestionDuplicateCandidate {
  id                     String                @id @default(cuid())
  collegeId              String
  college                College               @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  newQuestionId          String?
  newQuestion            Question?             @relation("DuplicateNewQuestion", fields: [newQuestionId], references: [id], onDelete: Cascade)
  existingQuestionId     String?
  existingQuestion       Question?             @relation("DuplicateExistingQuestion", fields: [existingQuestionId], references: [id], onDelete: SetNull)
  normalizedQuestionHash String
  similarityScore        Float
  duplicateReason        String
  semanticScore          Float?
  fuzzyScore             Float?
  embeddingProvider      String?
  embeddingModel         String?
  reviewedStatus         DuplicateReviewStatus @default(PENDING)
  reviewerId             String?
  reviewedAt             DateTime?
  metadata               Json?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([collegeId])
  @@index([newQuestionId])
  @@index([existingQuestionId])
  @@index([normalizedQuestionHash])
  @@index([reviewedStatus])
}

model QuestionEmbedding {
  id             String    @id @default(cuid())
  collegeId      String
  college        College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  questionId     String?
  question       Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sourceTextHash String
  provider       String
  model          String
  vector         Json
  metadata       Json?
  createdAt      DateTime  @default(now())

  @@unique([sourceTextHash, provider, model])
  @@index([collegeId])
  @@index([questionId])
}

model Syllabus {
  id               String         @id @default(cuid())
  collegeId        String
  college          College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courseId         String?
  semesterId       String?
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear     Int
  version          Int            @default(1)
  title            String
  learningOutcomes String[]
  status           EntityStatus   @default(ACTIVE)
  createdById      String?
  createdBy        User?          @relation("SyllabusCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?          @relation("SyllabusUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  units            SyllabusUnit[]

  @@unique([collegeId, subjectId, academicYear, version])
  @@index([collegeId])
  @@index([subjectId])
}

model SyllabusUnit {
  id          String          @id @default(cuid())
  syllabusId  String
  syllabus    Syllabus        @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  unitNumber  Int
  title       String
  description String?
  outcomes    String[]
  topics      SyllabusTopic[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([syllabusId, unitNumber])
  @@index([syllabusId])
}

model SyllabusTopic {
  id          String       @id @default(cuid())
  unitId      String
  unit        SyllabusUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topicName   String
  description String?
  outcomes    String[]
  aiSuggested Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([unitId])
}

model AssessmentBlueprint {
  id              String              @id @default(cuid())
  collegeId       String
  college         College             @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  assessmentId    String
  assessment      Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  subjectId       String?
  subject         Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  unit            String?
  topic           String?
  questionType    QuestionType?
  difficulty      QuestionDifficulty?
  bloomLevel      BloomLevel?
  questionCount   Int
  marks           Float
  autoRecommend   Boolean             @default(false)
  generateMissing Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([collegeId])
  @@index([assessmentId])
  @@index([subjectId])
}

model DeploymentMetadata {
  id          String   @id @default(cuid())
  version     String
  commitSha   String
  environment String
  buildTime   DateTime
  createdAt   DateTime @default(now())

  @@index([environment])
  @@index([commitSha])
}

model MaintenanceState {
  id              String    @id @default("global")
  enabled         Boolean   @default(false)
  message         String?
  allowAdmins     Boolean   @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  updatedByUserId String?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())
}
