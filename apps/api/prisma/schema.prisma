model User {
  id                       String                      @id @default(cuid())
  email                    String                      @unique
  studentId                String?                     @unique
  phone                    String?
  name                     String
  role                     Role
  passwordHash             String?
  mustChangePassword       Boolean                     @default(false)
  isActive                 Boolean                     @default(true)
  themePreference          ThemePreference             @default(SYSTEM)
  collegeId                String?
  college                  College?                    @relation("CollegeUsers", fields: [collegeId], references: [id])
  collegesCreated          College[]                   @relation("CollegeCreatedBy")
  collegesUpdated          College[]                   @relation("CollegeUpdatedBy")
  coursesLed               Course[]                    @relation("CourseInstructor")
  facultyProfile           FacultyProfile?
  studentProfile           StudentProfile?
  subjectAssignments       SubjectAssignment[]
  questionsCreated         Question[]                  @relation("QuestionCreatedBy")
  questionsUpdated         Question[]                  @relation("QuestionUpdatedBy")
  assessmentsCreated       Assessment[]                @relation("AssessmentCreatedBy")
  assessmentsUpdated       Assessment[]                @relation("AssessmentUpdatedBy")
  enrollments              Enrollment[]
  submissions              Submission[]
  testAttempts             TestAttempt[]
  attemptGrants            AssessmentAttemptGrant[]     @relation("AttemptGrantStudent")
  attemptGrantsCreated     AssessmentAttemptGrant[]     @relation("AttemptGrantCreatedBy")
  manualReviewsAssigned    ManualReviewTask[]          @relation("ManualReviewAssignedTo")
  notifications            Notification[]
  resultModerations        ResultModeration[]          @relation("ResultModeratedBy")
  securityReviews          AttemptSecurityReview[]     @relation("SecurityReviewedBy")
  passwordResetTokens      PasswordResetToken[]
  emailDeliveries          EmailDelivery[]
  storageObjects           StorageObject[]
  codeExecutionJobs        CodeExecutionJob[]
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  activityHistory          ActivityHistory[]
  permissionOverrides      UserPermissionOverride[]
  aiGenerationJobs         AiGenerationJob[]           @relation("AiGenerationRequestedBy")
  aiReviewDecisions        AiReviewDecision[]          @relation("AiReviewDecidedBy")
  aiResultVersionsEdited   AiGenerationResultVersion[] @relation("AiResultVersionEditedBy")
  aiPromptTemplatesCreated AiPromptTemplate[]          @relation("AiPromptCreatedBy")
  aiPromptTemplatesUpdated AiPromptTemplate[]          @relation("AiPromptUpdatedBy")
  documentImportJobs       DocumentImportJob[]         @relation("DocumentImportRequestedBy")
  syllabiCreated           Syllabus[]                  @relation("SyllabusCreatedBy")
  syllabiUpdated           Syllabus[]                  @relation("SyllabusUpdatedBy")
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@index([collegeId])
  @@index([role])
}

model College {
  id                   String                       @id @default(cuid())
  slug                 String                       @unique
  collegeCode          String                       @unique
  name                 String
  email                String                       @unique
  phone                String?
  website              String?
  addressLine1         String
  addressLine2         String?
  city                 String
  state                String
  postalCode           String
  country              String
  logoUrl              String?
  status               CollegeStatus                @default(ACTIVE)
  isActive             Boolean                      @default(true)
  deletedAt            DateTime?
  createdById          String?
  createdBy            User?                        @relation("CollegeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            User?                        @relation("CollegeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  users                User[]                       @relation("CollegeUsers")
  departments          Department[]
  courses              Course[]
  semesters            Semester[]
  subjects             Subject[]
  batches              Batch[]
  facultyProfiles      FacultyProfile[]
  studentProfiles      StudentProfile[]
  questionBank         Question[]
  questionTags         Tag[]
  assessmentsManaged   Assessment[]
  auditLogs            AuditLog[]
  testAttempts         TestAttempt[]
  attemptGrants        AssessmentAttemptGrant[]
  results              Result[]
  notifications        Notification[]
  settings             CollegeSettings?
  activityHistory      ActivityHistory[]
  permissionOverrides  UserPermissionOverride[]
  storageObjects       StorageObject[]
  codeExecutionJobs    CodeExecutionJob[]
  aiGenerationJobs     AiGenerationJob[]
  aiUsageRecords       AiUsageRecord[]
  aiPromptTemplates    AiPromptTemplate[]
  aiProviderFailures   AiProviderFailure[]
  documentImportJobs   DocumentImportJob[]
  importedDocuments    ImportedDocument[]
  duplicateCandidates  QuestionDuplicateCandidate[]
  questionEmbeddings   QuestionEmbedding[]
  syllabi              Syllabus[]
  assessmentBlueprints AssessmentBlueprint[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([name])
  @@index([city])
  @@index([state])
  @@index([status])
  @@index([deletedAt])
  @@index([createdById])
}

model RefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String     @id @default(cuid())
  event     AuditEvent
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  collegeId String?
  college   College?   @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  actorRole Role?
  metadata  Json?
  createdAt DateTime   @default(now())

  @@index([event])
  @@index([userId])
  @@index([collegeId])
}

model CollegeSettings {
  id                     String   @id @default(cuid())
  collegeId              String   @unique
  college                College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  timezone               String   @default("Asia/Kolkata")
  academicYearStartMonth Int      @default(6)
  brandingColor          String   @default("#0f5d4e")
  notificationsEnabled   Boolean  @default(true)
  examGraceMinutes       Int      @default(5)
  updatedById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([collegeId])
}

model UserPermissionOverride {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId String?
  college   College? @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  module    String
  canView   Boolean  @default(true)
  canCreate Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module])
  @@index([collegeId])
  @@index([module])
}

model ActivityHistory {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  collegeId String?
  college   College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  action    String
  summary   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([collegeId])
  @@index([action])
  @@index([createdAt])
}

model Course {
  id              String           @id @default(cuid())
  code            String           @unique
  title           String
  term            String
  instructorId    String
  instructor      User             @relation("CourseInstructor", fields: [instructorId], references: [id])
  courseName      String?
  shortName       String?
  durationYears   Int?
  totalSemesters  Int?
  status          EntityStatus     @default(ACTIVE)
  collegeId       String?
  college         College?         @relation(fields: [collegeId], references: [id])
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id])
  assessments     Assessment[]
  enrollments     Enrollment[]
  semesters       Semester[]
  subjects        Subject[]
  batches         Batch[]
  studentProfiles StudentProfile[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([collegeId])
  @@index([departmentId])
  @@index([status])
}

model Department {
  id              String           @id @default(cuid())
  departmentName  String
  departmentCode  String
  description     String?
  status          EntityStatus     @default(ACTIVE)
  collegeId       String
  college         College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courses         Course[]
  subjects        Subject[]
  facultyProfiles FacultyProfile[]
  studentProfiles StudentProfile[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([collegeId, departmentCode])
  @@index([collegeId])
  @@index([status])
  @@index([departmentName])
}

model Semester {
  id                 String              @id @default(cuid())
  semesterNumber     Int
  semesterName       String
  status             EntityStatus        @default(ACTIVE)
  collegeId          String
  college            College             @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subjects           Subject[]
  batches            Batch[]
  studentProfiles    StudentProfile[]
  subjectAssignments SubjectAssignment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([courseId, semesterNumber])
  @@index([collegeId])
  @@index([courseId])
  @@index([status])
}

model Subject {
  id                 String                @id @default(cuid())
  subjectName        String
  subjectCode        String
  credits            Int
  status             EntityStatus          @default(ACTIVE)
  collegeId          String
  college            College               @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semesterId         String
  semester           Semester              @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  assignments        SubjectAssignment[]
  questions          Question[]
  questionImportJobs QuestionImportJob[]
  assessmentsBuilt   Assessment[]
  aiGenerationJobs   AiGenerationJob[]
  documentImportJobs DocumentImportJob[]
  syllabi            Syllabus[]
  blueprintRows      AssessmentBlueprint[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([collegeId, subjectCode])
  @@index([collegeId])
  @@index([departmentId])
  @@index([courseId])
  @@index([semesterId])
  @@index([status])
}

model Batch {
  id                         String                      @id @default(cuid())
  batchName                  String
  academicYear               Int
  section                    String
  status                     EntityStatus                @default(ACTIVE)
  collegeId                  String
  college                    College                     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courseId                   String
  course                     Course                      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semesterId                 String
  semester                   Semester                    @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  studentProfiles            StudentProfile[]
  subjectAssignments         SubjectAssignment[]
  assessmentBatchAssignments AssessmentBatchAssignment[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@unique([collegeId, academicYear, courseId, section])
  @@index([collegeId])
  @@index([courseId])
  @@index([semesterId])
  @@index([status])
}

model FacultyProfile {
  id              String              @id @default(cuid())
  employeeId      String
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId       String
  college         College             @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designation     String
  qualification   String
  experienceYears Int
  joiningDate     DateTime
  status          EntityStatus        @default(ACTIVE)
  assignments     SubjectAssignment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([collegeId, employeeId])
  @@index([collegeId])
  @@index([departmentId])
  @@index([status])
}

model StudentProfile {
  id                           String                        @id @default(cuid())
  rollNumber                   String
  userId                       String                        @unique
  user                         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId                    String
  college                      College                       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentId                 String
  department                   Department                    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courseId                     String
  course                       Course                        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semesterId                   String
  semester                     Semester                      @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  batchId                      String
  batch                        Batch                         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  section                      String
  gender                       Gender                        @default(NOT_SPECIFIED)
  dob                          DateTime?
  address                      String?
  guardianName                 String?
  guardianPhone                String?
  admissionYear                Int
  status                       EntityStatus                  @default(ACTIVE)
  assessmentStudentAssignments AssessmentStudentAssignment[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  @@unique([collegeId, rollNumber])
  @@index([collegeId])
  @@index([departmentId])
  @@index([courseId])
  @@index([semesterId])
  @@index([batchId])
  @@index([status])
}

model SubjectAssignment {
  id           String         @id @default(cuid())
  collegeId    String
  facultyId    String
