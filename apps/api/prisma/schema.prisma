generator client {
  provider = "prisma-client-js"
  output   = "../generated/phase5-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  ADMIN
  SUPER_ADMIN
  COLLEGE_ADMIN
  FACULTY
  STUDENT
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum AuditEvent {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  REFRESH
  LOGOUT
  COLLEGE_CREATE
  COLLEGE_UPDATE
  COLLEGE_ACTIVATE
  COLLEGE_DEACTIVATE
  COLLEGE_DELETE
  QUESTION_CREATE
  QUESTION_UPDATE
  QUESTION_DUPLICATE
  QUESTION_ACTIVATE
  QUESTION_DEACTIVATE
  QUESTION_ARCHIVE
  QUESTION_DELETE
  QUESTION_IMPORT
  QUESTION_EXPORT
  ASSESSMENT_CREATE
  ASSESSMENT_UPDATE
  ASSESSMENT_DUPLICATE
  ASSESSMENT_PUBLISH
  ASSESSMENT_SCHEDULE
  ASSESSMENT_CANCEL
  ATTEMPT_START
  ANSWER_SAVE
  ATTEMPT_SUBMIT
  ATTEMPT_AUTO_SUBMIT
  RESULT_PUBLISH
  RESULT_UNPUBLISH
  REVIEW_UPDATE
  ATTEMPT_SECURITY_EVENT
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
  EMAIL_QUEUED
  EMAIL_DELIVERED
  EMAIL_FAILED
  MAINTENANCE_MODE_UPDATE
  ADMIN_SETTINGS_UPDATE
  PROFILE_UPDATE
  NOTIFICATION_READ
  PERMISSION_OVERRIDE_UPDATE
  AI_GENERATION_REQUEST
  AI_GENERATION_COMPLETE
  AI_GENERATION_FAILURE
  AI_REVIEW_DECISION
  AI_PROMPT_TEMPLATE_UPDATE
  DOCUMENT_IMPORT_CREATE
  DOCUMENT_IMPORT_PROCESS
  DOCUMENT_IMPORT_APPROVE
  DUPLICATE_REVIEW
  SYLLABUS_UPDATE
}

enum EmailProvider {
  CONSOLE
  SMTP
  RESEND
  SENDGRID
  SES
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum PasswordResetStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum CodeExecutionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  INTERNAL_ERROR
}

enum CollegeStatus {
  ACTIVE
  INACTIVE
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NOT_SPECIFIED
}

enum AssessmentStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  PUBLISHED
  CLOSED
}

enum ResultVisibility {
  NEVER
  AFTER_SUBMISSION
  AFTER_END
  SCHEDULED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_IN_THE_BLANK
  NUMERICAL
  SHORT_ANSWER
  DESCRIPTIVE
  CODING
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum QuestionStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AiGenerationJobStatus {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum AiReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SAVED
}

enum AiDecisionType {
  APPROVE
  REJECT
  REGENERATE
  EDIT
  SAVE_TO_BANK
}

enum AiPromptFeatureType {
  QUESTION_GENERATION
  QUESTION_EXTRACTION
  ANSWER_EXPLANATION
  DUPLICATE_REVIEW
  DIFFICULTY_CLASSIFICATION
  BLOOM_CLASSIFICATION
  SYLLABUS_MAPPING
}

enum DocumentImportStatus {
  UPLOADED
  EXTRACTING
  EXTRACTED
  OCR_REQUIRED
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum DuplicateReviewStatus {
  PENDING
  KEEP_BOTH
  MERGED
  REJECT_NEW
  NOT_DUPLICATE
}

enum TestCaseVisibility {
  PUBLIC
  HIDDEN
}

enum SubmissionStatus {
  STARTED
  SUBMITTED
  GRADED
}

enum TestAttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
  CANCELLED
  UNDER_REVIEW
  EVALUATED
}

enum PassStatus {
  PENDING
  PASS
  FAIL
}

enum ManualReviewStatus {
  PENDING
  ASSIGNED
  COMPLETED
}

enum AttemptSecurityEventType {
  TAB_HIDDEN
  FULLSCREEN_EXIT
  RECONNECT
  DISCONNECT
  COPY
  PASTE
  TEST_START
  ANSWER_SAVE_FAILURE
  LATE_SUBMISSION
  DUPLICATE_SESSION
}

enum BackgroundJobStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
}

enum NotificationType {
  ASSESSMENT_ASSIGNED
  ASSESSMENT_STARTING_SOON
  SUBMISSION_RECEIPT
  RESULT_PUBLISHED
  REVIEW_COMPLETED
  ACCOUNT_STATUS_CHANGE
}

enum NotificationStatus {
  UNREAD
  READ
  SENT
  FAILED
}

enum SecurityReviewStatus {
  NORMAL
  FLAGGED
  REVIEWED
  CLEARED
}

enum ModerationStatus {
  NONE
  HELD
  RELEASED
  ADJUSTED
}

enum AttemptSessionPolicy {
  WARN_ONLY
  BLOCK_SECOND_SESSION
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  studentId                String?                  @unique
  phone                    String?
  name                     String
  role                     Role
  passwordHash             String?
  mustChangePassword       Boolean                  @default(false)
  isActive                 Boolean                  @default(true)
  themePreference          ThemePreference          @default(SYSTEM)
  collegeId                String?
  college                  College?                 @relation("CollegeUsers", fields: [collegeId], references: [id])
  collegesCreated          College[]                @relation("CollegeCreatedBy")
  collegesUpdated          College[]                @relation("CollegeUpdatedBy")
  coursesLed               Course[]                 @relation("CourseInstructor")
  facultyProfile           FacultyProfile?
  studentProfile           StudentProfile?
  subjectAssignments       SubjectAssignment[]
  questionsCreated         Question[]               @relation("QuestionCreatedBy")
  questionsUpdated         Question[]               @relation("QuestionUpdatedBy")
  assessmentsCreated       Assessment[]             @relation("AssessmentCreatedBy")
  assessmentsUpdated       Assessment[]             @relation("AssessmentUpdatedBy")
  enrollments              Enrollment[]
  submissions              Submission[]
  testAttempts             TestAttempt[]
  manualReviewsAssigned    ManualReviewTask[]       @relation("ManualReviewAssignedTo")
  notifications            Notification[]
  resultModerations        ResultModeration[]       @relation("ResultModeratedBy")
  securityReviews          AttemptSecurityReview[]  @relation("SecurityReviewedBy")
  passwordResetTokens      PasswordResetToken[]
  emailDeliveries          EmailDelivery[]
  storageObjects           StorageObject[]
  codeExecutionJobs        CodeExecutionJob[]
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  activityHistory          ActivityHistory[]
  permissionOverrides      UserPermissionOverride[]
  aiGenerationJobs         AiGenerationJob[]        @relation("AiGenerationRequestedBy")
  aiReviewDecisions        AiReviewDecision[]       @relation("AiReviewDecidedBy")
  aiResultVersionsEdited   AiGenerationResultVersion[] @relation("AiResultVersionEditedBy")
  aiPromptTemplatesCreated AiPromptTemplate[]       @relation("AiPromptCreatedBy")
  aiPromptTemplatesUpdated AiPromptTemplate[]       @relation("AiPromptUpdatedBy")
  documentImportJobs       DocumentImportJob[]      @relation("DocumentImportRequestedBy")
  syllabiCreated           Syllabus[]               @relation("SyllabusCreatedBy")
  syllabiUpdated           Syllabus[]               @relation("SyllabusUpdatedBy")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([collegeId])
  @@index([role])
}

model College {
  id                   String                       @id @default(cuid())
  slug                 String                       @unique
  collegeCode          String                       @unique
  name                 String
  email                String                       @unique
  phone                String?
  website              String?
  addressLine1         String
  addressLine2         String?
  city                 String
  state                String
  postalCode           String
  country              String
  logoUrl              String?
  status               CollegeStatus                @default(ACTIVE)
  isActive             Boolean                      @default(true)
  deletedAt            DateTime?
  createdById          String?
  createdBy            User?                        @relation("CollegeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            User?                        @relation("CollegeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  users                User[]                       @relation("CollegeUsers")
  departments          Department[]
  courses              Course[]
  semesters            Semester[]
  subjects             Subject[]
  batches              Batch[]
  facultyProfiles      FacultyProfile[]
  studentProfiles      StudentProfile[]
  questionBank         Question[]
  questionTags         Tag[]
  assessmentsManaged   Assessment[]
  auditLogs            AuditLog[]
  testAttempts         TestAttempt[]
  results              Result[]
  notifications        Notification[]
  settings             CollegeSettings?
  activityHistory      ActivityHistory[]
  permissionOverrides  UserPermissionOverride[]
  storageObjects       StorageObject[]
  codeExecutionJobs    CodeExecutionJob[]
  aiGenerationJobs     AiGenerationJob[]
  aiUsageRecords       AiUsageRecord[]
  aiPromptTemplates    AiPromptTemplate[]
  aiProviderFailures   AiProviderFailure[]
  documentImportJobs   DocumentImportJob[]
  importedDocuments    ImportedDocument[]
  duplicateCandidates  QuestionDuplicateCandidate[]
  questionEmbeddings   QuestionEmbedding[]
  syllabi              Syllabus[]
  assessmentBlueprints AssessmentBlueprint[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([name])
  @@index([city])
  @@index([state])
  @@index([status])
  @@index([deletedAt])
  @@index([createdById])
}

model RefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String     @id @default(cuid())
  event     AuditEvent
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  collegeId String?
  college   College?   @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  actorRole Role?
  metadata  Json?
  createdAt DateTime   @default(now())

  @@index([event])
  @@index([userId])
  @@index([collegeId])
}

model CollegeSettings {
  id                     String   @id @default(cuid())
  collegeId              String   @unique
  college                College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  timezone               String   @default("Asia/Kolkata")
  academicYearStartMonth Int      @default(6)
  brandingColor          String   @default("#0f5d4e")
  notificationsEnabled   Boolean  @default(true)
  examGraceMinutes       Int      @default(5)
  updatedById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([collegeId])
}

model UserPermissionOverride {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId String?
  college   College? @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  module    String
  canView   Boolean  @default(true)
  canCreate Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module])
  @@index([collegeId])
  @@index([module])
}

model ActivityHistory {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  collegeId String?
  college   College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  action    String
  summary   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([collegeId])
  @@index([action])
  @@index([createdAt])
}

model Course {
  id              String           @id @default(cuid())
  code            String           @unique
  title           String
  term            String
  instructorId    String
  instructor      User             @relation("CourseInstructor", fields: [instructorId], references: [id])
  courseName      String?
  shortName       String?
  durationYears   Int?
  totalSemesters  Int?
  status          EntityStatus     @default(ACTIVE)
  collegeId       String?
  college         College?         @relation(fields: [collegeId], references: [id])
  departmentId    String?
  department      Department?      @relation(fields: [departmentId], references: [id])
  assessments     Assessment[]
  enrollments     Enrollment[]
  semesters       Semester[]
  subjects        Subject[]
  batches         Batch[]
  studentProfiles StudentProfile[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([collegeId])
  @@index([departmentId])
  @@index([status])
}

model Department {
  id              String           @id @default(cuid())
  departmentName  String
  departmentCode  String
  description     String?
  status          EntityStatus     @default(ACTIVE)
  collegeId       String
  college         College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courses         Course[]
  subjects        Subject[]
  facultyProfiles FacultyProfile[]
  studentProfiles StudentProfile[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([collegeId, departmentCode])
  @@index([collegeId])
  @@index([status])
  @@index([departmentName])
}

model Semester {
  id                 String              @id @default(cuid())
  semesterNumber     Int
  semesterName       String
  status             EntityStatus        @default(ACTIVE)
  collegeId          String
  college            College             @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subjects           Subject[]
  batches            Batch[]
  studentProfiles    StudentProfile[]
  subjectAssignments SubjectAssignment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([courseId, semesterNumber])
  @@index([collegeId])
  @@index([courseId])
  @@index([status])
}

model Subject {
  id                 String                @id @default(cuid())
  subjectName        String
  subjectCode        String
  credits            Int
  status             EntityStatus          @default(ACTIVE)
  collegeId          String
  college            College               @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semesterId         String
  semester           Semester              @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  assignments        SubjectAssignment[]
  questions          Question[]
  assessmentsBuilt   Assessment[]
  aiGenerationJobs   AiGenerationJob[]
  documentImportJobs DocumentImportJob[]
  syllabi            Syllabus[]
  blueprintRows      AssessmentBlueprint[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([collegeId, subjectCode])
  @@index([collegeId])
  @@index([departmentId])
  @@index([courseId])
  @@index([semesterId])
  @@index([status])
}

model Batch {
  id                         String                      @id @default(cuid())
  batchName                  String
  academicYear               Int
  section                    String
  status                     EntityStatus                @default(ACTIVE)
  collegeId                  String
  college                    College                     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  courseId                   String
  course                     Course                      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semesterId                 String
  semester                   Semester                    @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  studentProfiles            StudentProfile[]
  subjectAssignments         SubjectAssignment[]
  assessmentBatchAssignments AssessmentBatchAssignment[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@unique([collegeId, academicYear, courseId, section])
  @@index([collegeId])
  @@index([courseId])
  @@index([semesterId])
  @@index([status])
}

model FacultyProfile {
  id              String              @id @default(cuid())
  employeeId      String
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId       String
  college         College             @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designation     String
  qualification   String
  experienceYears Int
  joiningDate     DateTime
  status          EntityStatus        @default(ACTIVE)
  assignments     SubjectAssignment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([collegeId, employeeId])
  @@index([collegeId])
  @@index([departmentId])
  @@index([status])
}

model StudentProfile {
  id                           String                        @id @default(cuid())
  rollNumber                   String
  userId                       String                        @unique
  user                         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId                    String
  college                      College                       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentId                 String
  department                   Department                    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  courseId                     String
  course                       Course                        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semesterId                   String
  semester                     Semester                      @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  batchId                      String
  batch                        Batch                         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  section                      String
  gender                       Gender                        @default(NOT_SPECIFIED)
  dob                          DateTime?
  address                      String?
  guardianName                 String?
  guardianPhone                String?
  admissionYear                Int
  status                       EntityStatus                  @default(ACTIVE)
  assessmentStudentAssignments AssessmentStudentAssignment[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  @@unique([collegeId, rollNumber])
  @@index([collegeId])
  @@index([departmentId])
  @@index([courseId])
  @@index([semesterId])
  @@index([batchId])
  @@index([status])
}

model SubjectAssignment {
  id           String         @id @default(cuid())
  collegeId    String
  facultyId    String
  faculty      FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  subjectId    String
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semesterId   String
  semester     Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  batchId      String
  batch        Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  status       EntityStatus   @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([facultyId, subjectId, semesterId, batchId])
  @@index([collegeId])
  @@index([departmentId])
  @@index([subjectId])
  @@index([semesterId])
  @@index([batchId])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Assessment {
  id                     String                        @id @default(cuid())
  collegeId              String?
  college                College?                      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  instructions           String?
  subjectId              String?
  subject                Subject?                      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  status                 AssessmentStatus              @default(DRAFT)
  durationMinutes        Int?
  totalMarks             Float                         @default(0)
  passingMarks           Float?
  maxAttempts            Int                           @default(1)
  startAt                DateTime?
  endAt                  DateTime?
  resultVisibility       ResultVisibility              @default(AFTER_END)
  resultPublishAt        DateTime?
  shuffleQuestions       Boolean                       @default(false)
  shuffleOptions         Boolean                       @default(false)
  allowSectionNavigation Boolean                       @default(true)
  allowBackNavigation    Boolean                       @default(true)
  negativeMarkingEnabled Boolean                       @default(false)
  fullscreenPreferred    Boolean                       @default(false)
  createdById            String?
  createdBy              User?                         @relation("AssessmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById            String?
  updatedBy              User?                         @relation("AssessmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  opensAt                DateTime?
  closesAt               DateTime?
  durationMin            Int?
  courseId               String?
  course                 Course?                       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  legacyQuestions        Question[]                    @relation("LegacyAssessmentQuestions")
  sections               AssessmentSection[]
  assessmentQuestions    AssessmentQuestion[]
  assignments            AssessmentAssignment[]
  batchAssignments       AssessmentBatchAssignment[]
  studentAssignments     AssessmentStudentAssignment[]
  submissions            Submission[]
  testAttempts           TestAttempt[]
  results                Result[]
  blueprints             AssessmentBlueprint[]
  deletedAt              DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@index([collegeId])
  @@index([subjectId])
  @@index([status])
  @@index([createdById])
  @@index([deletedAt])
}

model Question {
  id                   String                       @id @default(cuid())
  collegeId            String?
  college              College?                     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  subjectId            String?
  subject              Subject?                     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic                String?
  title                String?
  questionText         String?
  questionType         QuestionType?
  difficulty           QuestionDifficulty           @default(MEDIUM)
  defaultMarks         Float                        @default(1)
  defaultNegativeMarks Float                        @default(0)
  explanation          String?
  status               QuestionStatus               @default(DRAFT)
  createdById          String?
  createdBy            User?                        @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            User?                        @relation("QuestionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedAt            DateTime?
  version              Int                          @default(1)
  language             String?
  metadata             Json?
  prompt               String?
  points               Int?
  order                Int?
  assessmentId         String?
  assessment           Assessment?                  @relation("LegacyAssessmentQuestions", fields: [assessmentId], references: [id], onDelete: Cascade)
  options              QuestionOption[]
  tags                 QuestionTag[]
  codingQuestion       CodingQuestion?
  attachments          QuestionAttachment[]
  assessmentQuestions  AssessmentQuestion[]
  aiGenerationResults  AiGenerationResult[]
  extractedCandidates  ExtractedQuestionCandidate[]
  duplicateMatches     QuestionDuplicateCandidate[] @relation("DuplicateExistingQuestion")
  duplicateNewMatches  QuestionDuplicateCandidate[] @relation("DuplicateNewQuestion")
  embeddings           QuestionEmbedding[]
  answers              Answer[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@unique([assessmentId, order])
  @@index([collegeId])
  @@index([subjectId])
  @@index([questionType])
  @@index([difficulty])
  @@index([status])
  @@index([createdById])
  @@index([deletedAt])
}

model QuestionOption {
  id            String   @id @default(cuid())
  questionId    String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText    String
  optionKey     String
  displayOrder  Int
  isCorrect     Boolean  @default(false)
  explanation   String?
  mediaMetadata Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([questionId, optionKey])
  @@index([questionId])
}

model Tag {
  id        String        @id @default(cuid())
  collegeId String
  college   College       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  questions QuestionTag[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

