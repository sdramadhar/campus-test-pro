JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SWAGGER_ENABLED=true
REQUEST_BODY_LIMIT=1mb

EMAIL_PROVIDER=console
EMAIL_FROM=CampusTest Pro <no-reply@campustest.local>
SMTP_URL=
RESEND_API_KEY=
SENDGRID_API_KEY=

LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage
STORAGE_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

CODE_RUNNER_MODE=disabled
CODE_RUNNER_QUEUE=code-execution
CODE_RUNNER_INTERNAL_URL=

WORKER_REQUIRED=false
WORKER_CONCURRENCY=5
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_HEARTBEAT_TTL_MS=60000
WORKER_SHUTDOWN_TIMEOUT_MS=30000
QUEUE_ATTEMPT_EXPIRY=attempt-expiry
QUEUE_RESULT_CALCULATION=result-calculation

MAINTENANCE_MODE=false
ALLOW_ADMIN_DURING_MAINTENANCE=true
